rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- User Profiles ---
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) 
        && incoming().uid == userId
        && incoming().email is string
        && incoming().keys().hasAll(['uid', 'email']);
      // Only fields the app actually writes may change (diff-based whitelist).
      // Notably 'role' is NOT in this list, so it can never be self-assigned.
      allow update: if isOwner(userId)
        && incoming().uid == userId
        && incoming().email == existing().email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid', 'email', 'displayName', 'photoURL', 'updatedAt',
          'settings',
          'streak', 'streakDays', 'lastStudyDate',
          'totalCardsLearned', 'totalCardsReviewed', 'totalQuizzesCompleted',
          'totalStudyTimeMinutes', 'lastQuizCompletedAt',
          'badges', 'achievements', 'xp', 'level'
        ]);
        
      // Nested collections for user data
      match /sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && incoming().keys().size() <= 60;
        allow delete: if isOwner(userId);
      }
      match /examResults/{resultId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && incoming().keys().size() <= 60;
        allow delete: if isOwner(userId);
      }
      match /cardProgress/{progressId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && incoming().userId == userId
          && incoming().deckId is string
          && incoming().cardId is string;
        // Delete has its own rule: incoming() is null on delete, so folding
        // delete into the create/update condition makes it always false.
        allow delete: if isOwner(userId);
      }
      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && incoming().userId == userId
          && incoming().id == notificationId
          && incoming().title is string
          && incoming().message is string;
        // Delete split out for the same reason as cardProgress above.
        allow delete: if isOwner(userId);
      }
    }

    // --- Leaderboard (written by Settings when the profile changes) ---
    // Only the public display fields the app actually writes are allowed
    // (Settings writes {username, avatar}); scores can never be written here.
    match /leaderboards/global/users/{userId} {
      allow get, list: if isSignedIn();
      allow create, update: if isOwner(userId)
        && incoming().keys().hasOnly(['username', 'avatar'])
        && incoming().username is string;
      allow delete: if false;
    }

    match /review_logs/{logId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().dateKey is string;
      allow update, delete: if false;
    }

    match /quiz_logs/{logId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().dateKey is string;
      allow update, delete: if false;
    }

    // --- Decks ---
    match /decks/{deckId} {
      allow read: if isSignedIn() && (existing().isPublic == true || isOwner(existing().ownerId));
      allow create: if isSignedIn() 
        && incoming().ownerId == request.auth.uid
        && incoming().name is string
        && incoming().name.size() > 0;
      allow update: if isOwner(existing().ownerId)
        && incoming().ownerId == existing().ownerId;
      allow delete: if isOwner(existing().ownerId);

      // --- Cards (Subcollection of Decks) ---
      match /cards/{cardId} {
        allow read: if isSignedIn() && (get(/databases/$(database)/documents/decks/$(deckId)).data.isPublic == true || isOwner(get(/databases/$(database)/documents/decks/$(deckId)).data.ownerId));
        allow create, update, delete: if isSignedIn() && isOwner(get(/databases/$(database)/documents/decks/$(deckId)).data.ownerId);

        match /reviews/{reviewId} {
          allow read, write: if isSignedIn() && isOwner(get(/databases/$(database)/documents/decks/$(deckId)).data.ownerId);
        }
      }
    }
  }
}
