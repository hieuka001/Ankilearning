rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwnDailyMissionId(missionId) {
      return isSignedIn()
        && missionId.matches('^' + request.auth.uid + '_[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // --- User Profiles ---
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) 
        && incoming().uid == userId
        && incoming().email is string
        && incoming().keys().hasAll(['uid', 'email']);
      allow update: if isOwner(userId)
        && incoming().uid == userId
        && incoming().email == existing().email;
        
      // Nested collections for user data
      match /sessions/{sessionId} {
        allow read, write: if isOwner(userId);
      }
      match /examResults/{resultId} {
        allow read, write: if isOwner(userId);
      }
      match /cardProgress/{progressId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId)
          && incoming().userId == userId
          && incoming().deckId is string
          && incoming().cardId is string;
      }
      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId)
          && incoming().userId == userId
          && incoming().id == notificationId
          && incoming().title is string
          && incoming().message is string;
      }
    }

    // --- Gamification ---
    match /daily_missions/{missionId} {
      allow get: if isOwnDailyMissionId(missionId);
      allow list: if false;
      allow create: if isOwnDailyMissionId(missionId)
        && incoming().userId == request.auth.uid
        && incoming().dateKey is string
        && incoming().missions is list;
      allow update: if isOwnDailyMissionId(missionId)
        && incoming().userId == request.auth.uid
        && incoming().dateKey is string
        && incoming().missions is list;
      allow delete: if false;
    }

    match /leaderboards/{boardId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();

      match /users/{userId} {
        allow read: if isSignedIn();
        allow create, update: if isOwner(userId)
          && incoming().userId == userId
          && incoming().username is string
          && incoming().totalExp is number
          && incoming().rankScore is number;
        allow delete: if false;
      }
    }

    match /review_logs/{logId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().dateKey is string;
      allow update, delete: if false;
    }

    match /quiz_logs/{logId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().dateKey is string;
      allow update, delete: if false;
    }

    match /activity_logs/{logId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().dateKey is string;
      allow update, delete: if false;
    }

    // --- Decks ---
    match /decks/{deckId} {
      allow read: if isSignedIn() && (existing().isPublic == true || isOwner(existing().ownerId));
      allow create: if isSignedIn() 
        && incoming().ownerId == request.auth.uid
        && incoming().name is string
        && incoming().name.size() > 0;
      allow update: if isOwner(existing().ownerId)
        && incoming().ownerId == existing().ownerId;
      allow delete: if isOwner(existing().ownerId);

      // --- Cards (Subcollection of Decks) ---
      match /cards/{cardId} {
        allow read: if isSignedIn() && (get(/databases/$(database)/documents/decks/$(deckId)).data.isPublic == true || isOwner(get(/databases/$(database)/documents/decks/$(deckId)).data.ownerId));
        allow create, update, delete: if isSignedIn() && isOwner(get(/databases/$(database)/documents/decks/$(deckId)).data.ownerId);

        match /reviews/{reviewId} {
          allow read, write: if isSignedIn() && isOwner(get(/databases/$(database)/documents/decks/$(deckId)).data.ownerId);
        }
      }
    }
  }
}
