rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // App media (audio/images/video extracted from .apkg imports and uploads).
    // Paths are generated by src/services/ankiMediaStorage.ts:
    //   anki-media/{userId}/{timestamp}_{random}_{safeName}
    match /anki-media/{userId}/{fileName} {
      // The app requires sign-in for every feature, so reads require auth.
      allow read: if request.auth != null;

      // Only the owner may upload, capped at 20 MB, media content types only.
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 20 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('audio/.*')
          || request.resource.contentType.matches('video/.*'));

      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    // Everything else in the bucket is denied by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
