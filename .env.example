# Gemini API key used as the default AI key.
# Users can also configure their own key in the Settings page.
# Default model: gemini-2.5-flash. Fallback: gemini-2.5-flash-lite.
GEMINI_API_KEY=
# GOOGLE_API_KEY is also supported by the Gemini SDK.
# GOOGLE_API_KEY=

# Admin Gate Credentials
VITE_ADMIN_GATE_USER=admin
VITE_ADMIN_GATE_PASS=123456

# Daily study reminder email, triggered by Vercel Cron at 21:00 Vietnam time.
CRON_SECRET=
PUBLIC_APP_URL=https://learning-with-trunghieu.vercel.app
RESEND_API_KEY=
REMINDER_FROM_EMAIL=Learning Card <notify@your-domain.com>
FIREBASE_PROJECT_ID=anki-learning-78dac
FIRESTORE_DATABASE_ID=(default)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
