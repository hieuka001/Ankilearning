{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "center": true,
        "create": false,
        "fullscreen": false,
        "height": 820,
        "label": "main",
        "maximized": true,
        "minHeight": 560,
        "minWidth": 380,
        "resizable": true,
        "title": "AnkiLearning",
        "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36 Edg/126.0.0.0 AnkiLearningDesktop/1.0.5",
        "width": 1280
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../dist-fallback"
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "longDescription": "Ứng dụng học bằng thẻ ghi nhớ (flashcards) với thuật toán lặp lại ngắt quãng FSRS, AI Gemini, đồng bộ đám mây. Bản máy tính chạy trực tuyến cùng dữ liệu với bản web và điện thoại.",
    "shortDescription": "AnkiLearning — học bằng thẻ ghi nhớ với thuật toán FSRS",
    "targets": [
      "nsis",
      "msi",
      "dmg",
      "app",
      "deb",
      "appimage"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Vietnamese",
          "English"
        ]
      }
    }
  },
  "identifier": "com.hieuka001.ankilearning",
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "appLink": false,
          "scheme": [
            "ankilearning"
          ]
        }
      ],
      "desktop": {
        "schemes": [
          "ankilearning"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/hieuka001/Ankilearning/releases/latest/download/latest.json"
      ],
